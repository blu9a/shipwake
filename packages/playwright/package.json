{
  "name": "shipwake-playwright",
  "version": "0.1.0",
  "description": "Shipwake reporter and recording helpers for Playwright: every step, attachments as files, observed evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p ."
  },
  "peerDependencies": {
    "@playwright/test": ">=1.51"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blu9a/shipwake.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/blu9a/shipwake/tree/main/packages/playwright",
  "publishConfig": {
    "access": "public"
  }
}
